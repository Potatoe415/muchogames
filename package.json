{
  "name": "muchogames",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.14.0",
  "workspaces": [
    "apps/coinchapp"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:games": "node scripts/check-games.mjs",
    "check": "npm run lint && npm run format:check && npm run check:games && npm run build",
    "build:all": "turbo run build",
    "lint:all": "turbo run lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.3.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "vite": "^6.0.0"
  }
}
