# Server-only value used by api/yatsy/games/* to act as the Yatzy game
# authority. Never expose this to the browser. Set it as a Vercel project
# env var (Production + Preview), not in a committed file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth user ids (comma-separated) allowed into /admin via Google
# sign-in. Not a secret. Signing in on /admin with a non-listed account shows
# that account's user id, which is the value to put here.
ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000

# Server-only Giphy key for Yatzy GIF search in the reaction picker.
GIPHY_API_KEY=your-giphy-api-key
